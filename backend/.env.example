# No database is required. All curated records live in app/data/buildings.json.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# gemini | openai | auto (auto attempts Gemini, then OpenAI)
AI_PROVIDER=gemini
# Obtain from https://aistudio.google.com/apikey (free-tier availability/quota may vary).
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-2.5-flash
GEMINI_CHAT_MODEL=gemini-2.5-flash-lite
# Optional OpenAI fallback; OpenAI API is generally billed separately.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
